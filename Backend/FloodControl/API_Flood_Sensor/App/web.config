<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <system.webServer>

    <!-- Tell IIS to route all requests to Python + wfastcgi -->
    <handlers>
      <add 
        name="FastApiHandler"
        path="*"
        verb="*"
        modules="FastCgiModule"
        scriptProcessor="C:\Users\Lenovo\AppData\Local\Programs\Python\Python312\python.exe|C:\Users\Lenovo\AppData\Local\Programs\Python\Python312\Lib\site-packages\wfastcgi.py"
        resourceType="Unspecified"
        requireAccess="Script"
      />
    </handlers>

    <!-- Rewrite EVERYTHING to your WSGI entrypoint -->
    <rewrite>
      <rules>
        <rule name="FastAPI" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="app_wsgi.py" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>

  <!-- Environment variables for wfastcgi -->
  <appSettings>
    <!-- IMPORTANT: This must match your Python variable `app = handler` -->
    <add key="WSGI_HANDLER" value="app_wsgi.app" />

    <!-- Folder where app_wsgi.py and main.py exist -->
    <add key="PYTHONPATH" value="C:\Users\Lenovo\source\FloodControl\API_Flood_Sensor\App" />

    <!-- Log file for debugging -->
    <add key="WSGI_LOG" value="C:\Users\Lenovo\source\FloodControl\API_Flood_Sensor\App\wfastcgi.log" />
  </appSettings>

</configuration>
